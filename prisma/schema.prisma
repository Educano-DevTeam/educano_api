generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  ALUNO     @map("aluno")
  PROFESSOR @map("professor")
  PARCEIRO  @map("parceiro")
  ADMIN     @map("admin")

  @@map("tipo_usuario")
}

enum StatusUsuario {
  PENDENTE @map("pendente")
  ATIVO    @map("ativo")
  INATIVO  @map("inativo")

  @@map("status_usuario")
}

enum TipoPerfil {
  PUBLICO @map("publico")
  PRIVADO @map("privado")

  @@map("tipo_perfil")
}

enum StatusCodigoValidacao {
  ATIVO   @map("ativo")
  INATIVO @map("inativo")
  USADO   @map("usado")

  @@map("status_codigo_validacao")
}

enum TipoArquivo {
  IMAGEM
  VIDEO
  AUDIO
  PDF
  DOCUMENTO
  OUTRO

  @@map("tipo_arquivo")
}

enum FinalidadeArquivo {
  FOTO_PERFIL
  BACKGROUND_PERFIL
  CAPA_CURSO
  MATERIAL_CURSO
  MATERIAL_AULA
  OUTRO

  @@map("finalidade_arquivo")
}

enum StatusArquivo {
  PENDENTE
  CONCLUIDO
  FALHA

  @@map("status_arquivo")
}

enum CategoriaCurso {
  LINGUAGENS
  EXATAS
  CIENCIAS_HUMANAS
  CIENCIAS_NATURAIS
  REDACAO
  VESTIBULAR
  TECNOLOGIA
  INTELIGENCIA_ARTIFICIAL
  DESIGN
  FINANCAS

  @@map("categoria_curso")
}

enum StatusCurso {
  RASCUNHO
  INATIVO
  ATIVO

  @@map("status_curso")
}

enum TipoMaterial {
  VIDEO
  AUDIO
  PDF
  DOCUMENTO
  OUTRO

  @@map("tipo_material")
}

enum TipoTeste {
  SIMULADO
  ATIVIDADE

  @@map("tipo_teste")
}

enum NivelDificuldade {
  FACIL
  MEDIO
  DIFICIL

  @@map("nivel_dificuldade")
}

enum CategoriaItem {
  BOOST

  @@map("categoria_item")
}

enum IconeItem {
  RAIO
  ESCUDO
  LAMPADA
  CRONOMETRO
  REINICIAR
  AVATAR
  ESTRELA

  @@map("icone_item")
}

enum StatusItem {
  ATIVO
  INATIVO

  @@map("status_item")
}

enum StatusInventario {
  NAO_USADO
  ATIVO
  USADO

  @@map("status_inventario")
}

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  nome         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(255)
  senha        String        @db.VarChar(255)
  tipo         TipoUsuario   @default(ALUNO)
  status       StatusUsuario @default(PENDENTE)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  perfil           Perfil?
  codigosValidacao CodigoValidacao[]

  arquivos Arquivo[]

  cursosResponsavel Curso[] @relation("CursoResponsavel")
  cursosAutorizados Curso[] @relation("CursoAutorizado")

  sessoesResponsavel Sessao[]
  modulosResponsavel Modulo[]
  aulasResponsavel   Aula[]

  testesResponsavel         Teste[]
  tentativasTeste           TentativaTeste[]
  tentativasQuestoes        TentativaQuestao[]
  testesQuestoesResponsavel TesteQuestao[]
  questoesResponsavel       Questao[]
  alternativasResponsavel   Alternativa[]

  inscricoes Inscricao[]
  progressos Progresso[]

  itensCriados Item[]       @relation("ItemResponsavel")
  inventario   Inventario[]

  flashcards Flashcard[]

  // Cursos nos quais o usuário atua como professor.
  cursosComoProfessor CursoProfessor[] @relation("ProfessorCurso")

  // Vínculos de professores realizados por este usuário.
  vinculosProfessorCriados CursoProfessor[] @relation("ResponsavelVinculoProfessor")

  @@map("usuario")
}

model Perfil {
  idUsuario         String     @id @map("id_usuario") @db.Uuid
  tipoPerfil        TipoPerfil @default(PRIVADO) @map("tipo_perfil")
  planoContaId      String?    @map("plano_conta") @db.Uuid
  xp                Int        @default(0)
  moedas            Int        @default(0)
  nivel             Int        @default(0)
  cor               String     @default("") @db.VarChar(30)
  decoracaoId       String?    @map("decoracao") @db.Uuid
  urlFotoPerfil     String     @default("") @map("url_foto_perfil") @db.Text
  urlFotoBackground String     @default("") @map("url_foto_background") @db.Text

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("perfil")
}

model CodigoValidacao {
  id          String                @id @default(uuid()) @db.Uuid
  idUsuario   String                @map("id_usuario") @db.Uuid
  codigo      String                @db.VarChar(64)
  dataCriacao DateTime              @default(now()) @map("data_criacao") @db.Timestamptz(3)
  expiraEm    DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '10 minutes')")) @map("expira_em") @db.Timestamptz(3)
  status      StatusCodigoValidacao @default(ATIVO)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario, status])
  @@index([expiraEm, status])
  @@map("codigo_validacao")
}

model Arquivo {
  id String @id @default(uuid()) @db.Uuid

  idOrigem String @map("id_origem") @db.Uuid

  tipo       TipoArquivo
  finalidade FinalidadeArquivo

  nomeOriginal String @map("nome_original") @db.VarChar(255)

  chaveObjeto String @unique @map("chave_objeto") @db.VarChar(512)

  bucket String @db.VarChar(255)

  contentType String @map("content_type") @db.VarChar(150)

  tamanhoBytes BigInt @map("tamanho_bytes")

  etag String? @db.VarChar(255)

  status StatusArquivo @default(PENDENTE)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idOrigem], references: [id], onDelete: Restrict)

  aula      Aula?  @relation("ArquivoAula")
  cursoCapa Curso? @relation("ArquivoCapaCurso")

  @@index([idOrigem])
  @@index([finalidade])
  @@index([tipo])
  @@index([status])
  @@map("arquivo")
}

model Curso {
  id           String         @id @default(uuid()) @db.Uuid
  nome         String         @db.VarChar(150)
  categoria    CategoriaCurso
  status       StatusCurso    @default(INATIVO)
  cargaHoraria Int?           @map("carga_horaria")
  vagas        Int?
  preco        Decimal?       @db.Decimal(10, 2)
  descricao    String?        @db.Text
  cor          String?        @db.VarChar(30)

  // Capa do curso: arquivo enviado ou ícone selecionado
  idCapa    String? @unique @map("id_capa") @db.Uuid
  iconeCapa String? @map("icone_capa") @db.VarChar(30)

  // Responsáveis
  idResponsavel      String  @map("id_responsavel") @db.Uuid
  idAdminAutorizador String? @map("id_admin_autorizador") @db.Uuid

  // Datas
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  autorizadoEm DateTime? @map("autorizado_em") @db.Timestamptz(3)

  // Relacionamentos
  arquivoCapa      Arquivo? @relation("ArquivoCapaCurso", fields: [idCapa], references: [id], onDelete: SetNull)
  responsavel      Usuario  @relation("CursoResponsavel", fields: [idResponsavel], references: [id], onDelete: Restrict)
  adminAutorizador Usuario? @relation("CursoAutorizado", fields: [idAdminAutorizador], references: [id], onDelete: SetNull)

  sessoes     Sessao[]
  inscricoes  Inscricao[]
  professores CursoProfessor[]

  @@index([nome])
  @@index([categoria])
  @@index([status])
  @@index([idResponsavel])
  @@map("curso")
}

model Sessao {
  id String @id @default(uuid()) @db.Uuid

  idCurso String @map("id_curso") @db.Uuid

  titulo    String  @db.VarChar(150)
  subtitulo String? @db.VarChar(200)
  descricao String? @db.Text

  idResponsavel String @map("id_responsavel") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  curso       Curso   @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  modulos Modulo[]

  @@index([idCurso])
  @@index([idResponsavel])
  @@map("sessao")
}

model Modulo {
  id String @id @default(uuid()) @db.Uuid

  idSessao String @map("id_sessao") @db.Uuid

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text

  idResponsavel String @map("id_responsavel") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  sessao      Sessao  @relation(fields: [idSessao], references: [id], onDelete: Cascade)
  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  aulas  Aula[]
  testes Teste[]

  @@index([idSessao])
  @@index([idResponsavel])
  @@map("modulo")
}

model Aula {
  id String @id @default(uuid()) @db.Uuid

  idModulo String @map("id_modulo") @db.Uuid

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text

  idArquivo String? @unique @map("id_arquivo") @db.Uuid

  tipo TipoMaterial

  quantidadePaginas Int? @map("quantidade_paginas")
  duracaoMinutos    Int? @map("duracao_minutos")

  idResponsavel String @map("id_responsavel") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  modulo      Modulo   @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  arquivo     Arquivo? @relation("ArquivoAula", fields: [idArquivo], references: [id], onDelete: SetNull)
  responsavel Usuario  @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  progressos Progresso[]

  @@index([idModulo])
  @@index([idResponsavel])
  @@map("aula")
}

model Teste {
  id String @id @default(uuid()) @db.Uuid

  idModulo String? @map("id_modulo") @db.Uuid

  idResponsavel String @map("id_responsavel") @db.Uuid

  tipo TipoTeste
  tema String?   @db.VarChar(150)

  tempoMinutos Int @default(5) @map("tempo_minutos")

  dificuldade NivelDificuldade?

  quantidadeQuestoes Int @default(0) @map("quantidade_questoes")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  modulo      Modulo? @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  questoes   TesteQuestao[]
  tentativas TentativaTeste[]

  progressos Progresso[]

  @@index([idModulo])
  @@index([idResponsavel])
  @@index([tipo])
  @@map("teste")
}

model Questao {
  id                   String  @id @default(uuid()) @db.Uuid
  idResponsavel        String  @map("id_responsavel") @db.Uuid
  idAlternativaCorreta String? @map("id_alternativa_correta") @db.Uuid

  titulo      String?          @db.VarChar(150)
  enunciado   String           @db.Text
  dificuldade NivelDificuldade @default(MEDIO)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  alternativaCorreta Alternativa? @relation("AlternativaCorreta", fields: [idAlternativaCorreta], references: [id], onDelete: SetNull)

  alternativas Alternativa[]      @relation("AlternativasQuestao")
  testes       TesteQuestao[]
  tentativas   TentativaQuestao[]

  @@index([idResponsavel])
  @@index([idAlternativaCorreta])
  @@index([dificuldade])
  @@map("questao")
}

model Alternativa {
  id            String @id @default(uuid()) @db.Uuid
  idQuestao     String @map("id_questao") @db.Uuid
  idResponsavel String @map("id_responsavel") @db.Uuid

  texto String @db.Text
  letra String @db.VarChar(1)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  questao Questao @relation("AlternativasQuestao", fields: [idQuestao], references: [id], onDelete: Cascade)

  questoesCorretas Questao[] @relation("AlternativaCorreta")

  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  @@unique([idQuestao, letra])
  @@index([idQuestao])
  @@index([idResponsavel])
  @@map("alternativa")
}

model TesteQuestao {
  id String @id @default(uuid()) @db.Uuid

  idTeste   String @map("id_teste") @db.Uuid
  idQuestao String @map("id_questao") @db.Uuid

  ordem Int @default(0)

  idResponsavel String   @map("id_responsavel") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  teste   Teste   @relation(fields: [idTeste], references: [id], onDelete: Cascade)
  questao Questao @relation(fields: [idQuestao], references: [id], onDelete: Cascade)

  @@unique([idTeste, idQuestao])
  @@index([idQuestao])
  @@map("teste_questao")
}

model TentativaTeste {
  id String @id @default(uuid()) @db.Uuid

  idUsuario String @map("id_usuario") @db.Uuid
  idTeste   String @map("id_teste") @db.Uuid

  tempoConsumido Int?     @map("tempo_consumido")
  notaFinal      Decimal? @map("nota_final") @db.Decimal(5, 2)

  iniciadoEm DateTime  @default(now()) @map("iniciado_em") @db.Timestamptz(3)
  enviadoEm  DateTime? @map("enviado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  teste   Teste   @relation(fields: [idTeste], references: [id], onDelete: Restrict)

  questoes TentativaQuestao[]

  @@index([idUsuario])
  @@index([idTeste])
  @@index([enviadoEm])
  @@map("tentativa_teste")
}

model TentativaQuestao {
  id String @id @default(uuid()) @db.Uuid

  idTentativa String @map("id_tentativa") @db.Uuid
  idQuestao   String @map("id_questao") @db.Uuid

  // Snapshot do conteúdo apresentado ao aluno
  enunciado    String  @db.Text
  alternativaA String? @map("alternativa_a") @db.Text
  alternativaB String? @map("alternativa_b") @db.Text
  alternativaC String? @map("alternativa_c") @db.Text
  alternativaD String? @map("alternativa_d") @db.Text
  alternativaE String? @map("alternativa_e") @db.Text

  respostaCorreta String  @map("resposta_correta") @db.VarChar(1)
  respostaUsuario String? @map("resposta_usuario") @db.VarChar(1)

  acertou Boolean?

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  tentativa TentativaTeste @relation(fields: [idTentativa], references: [id], onDelete: Cascade)
  questao   Questao        @relation(fields: [idQuestao], references: [id], onDelete: Restrict)
  usuario   Usuario?       @relation(fields: [usuarioId], references: [id])
  usuarioId String?        @db.Uuid

  @@unique([idTentativa, idQuestao])
  @@index([idQuestao])
  @@map("tentativa_questao")
}

model Inscricao {
  id String @id @default(uuid()) @db.Uuid

  idUsuario String @map("id_usuario") @db.Uuid
  idCurso   String @map("id_curso") @db.Uuid

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  curso   Curso   @relation(fields: [idCurso], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idCurso])
  @@index([idCurso])
  @@map("inscricao")
}

model CursoProfessor {
  id String @id @default(uuid()) @db.Uuid

  idProfessor          String @map("id_professor") @db.Uuid
  idCurso              String @map("id_curso") @db.Uuid
  idResponsavelVinculo String @map("id_responsavel_vinculo") @db.Uuid

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  professor Usuario @relation("ProfessorCurso", fields: [idProfessor], references: [id], onDelete: Cascade)

  curso Curso @relation(fields: [idCurso], references: [id], onDelete: Cascade)

  responsavelVinculo Usuario @relation("ResponsavelVinculoProfessor", fields: [idResponsavelVinculo], references: [id], onDelete: Restrict)

  // Impede vínculos duplicados.
  @@unique([idProfessor, idCurso])
  @@index([idCurso])
  @@index([idProfessor])
  @@index([idResponsavelVinculo])
  @@map("curso_professor")
}

model Progresso {
  id        String  @id @default(uuid()) @db.Uuid
  idUsuario String  @map("id_usuario") @db.Uuid
  idAula    String? @map("id_aula") @db.Uuid
  idTeste   String? @map("id_teste") @db.Uuid

  concluida   Boolean   @default(false)
  concluidoEm DateTime? @map("concluido_em") @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  aula    Aula?   @relation(fields: [idAula], references: [id], onDelete: Cascade)
  teste   Teste?  @relation(fields: [idTeste], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idAula])
  @@unique([idUsuario, idTeste])
  @@index([idUsuario])
  @@index([idAula])
  @@index([idTeste])
  @@map("progresso")
}

model Item {
  id        String        @id @default(uuid()) @db.Uuid
  nome      String        @db.VarChar(100)
  descricao String        @db.Text
  preco     Int
  categoria CategoriaItem @default(BOOST)
  icone     IconeItem
  boost     Float
  tempoUso  Int           @map("tempo_uso")
  cor       String        @db.VarChar(30)
  status    StatusItem    @default(ATIVO)

  idResponsavel String   @map("id_responsavel") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  responsavel Usuario      @relation("ItemResponsavel", fields: [idResponsavel], references: [id], onDelete: Restrict)
  inventarios Inventario[]

  @@index([categoria])
  @@index([status])
  @@index([idResponsavel])
  @@map("item")
}

model Inventario {
  id        String           @id @default(uuid()) @db.Uuid
  idUsuario String           @map("id_usuario") @db.Uuid
  idItem    String           @map("id_item") @db.Uuid
  status    StatusInventario @default(NAO_USADO)

  compradoEm DateTime  @default(now()) @map("comprado_em") @db.Timestamptz(3)
  expiraEm   DateTime? @map("expira_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [idItem], references: [id], onDelete: Restrict)

  @@index([idUsuario, status])
  @@index([idItem])
  @@index([expiraEm])
  @@map("inventario")
}

model Flashcard {
  id        String @id @default(uuid()) @db.Uuid
  idUsuario String @map("id_usuario") @db.Uuid

  titulo        String @db.VarChar(150)
  pergunta      String @db.Text
  resposta      String @db.Text
  repeticoesMes Int    @map("repeticoes_mes")

  ultimaVisualizacao DateTime? @map("ultima_visualizacao") @db.Timestamptz(3)
  proximaVisualizacao DateTime @map("proxima_visualizacao") @db.Timestamptz(3)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@index([idUsuario, proximaVisualizacao])
  @@map("flashcard")
}