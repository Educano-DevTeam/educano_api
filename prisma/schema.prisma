generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  ALUNO     @map("aluno")
  PROFESSOR @map("professor")
  PARCEIRO  @map("parceiro")
  ADMIN     @map("admin")

  @@map("tipo_usuario")
}

enum StatusUsuario {
  PENDENTE @map("pendente")
  ATIVO    @map("ativo")
  INATIVO  @map("inativo")

  @@map("status_usuario")
}

enum TipoPerfil {
  PUBLICO @map("publico")
  PRIVADO @map("privado")

  @@map("tipo_perfil")
}

enum StatusCodigoValidacao {
  ATIVO   @map("ativo")
  INATIVO @map("inativo")
  USADO   @map("usado")

  @@map("status_codigo_validacao")
}

enum FinalidadeCodigo {
  VALIDACAO_CONTA   @map("validacao_conta")
  REDEFINICAO_SENHA @map("redefinicao_senha")

  @@map("finalidade_codigo")
}

enum TipoArquivo {
  IMAGEM
  VIDEO
  AUDIO
  PDF
  DOCUMENTO
  OUTRO

  @@map("tipo_arquivo")
}

enum FinalidadeArquivo {
  FOTO_PERFIL
  BACKGROUND_PERFIL
  CAPA_CURSO
  MATERIAL_CURSO
  MATERIAL_AULA
  OUTRO

  @@map("finalidade_arquivo")
}

enum StatusArquivo {
  PENDENTE
  CONCLUIDO
  FALHA

  @@map("status_arquivo")
}

enum CategoriaCurso {
  LINGUAGENS
  EXATAS
  CIENCIAS_HUMANAS
  CIENCIAS_NATURAIS
  REDACAO
  VESTIBULAR
  TECNOLOGIA
  INTELIGENCIA_ARTIFICIAL
  DESIGN
  FINANCAS

  @@map("categoria_curso")
}

enum StatusCurso {
  RASCUNHO
  INATIVO
  ATIVO

  @@map("status_curso")
}

enum TipoMaterial {
  VIDEO
  AUDIO
  PDF
  DOCUMENTO
  OUTRO

  @@map("tipo_material")
}

enum TipoTeste {
  SIMULADO
  ATIVIDADE

  @@map("tipo_teste")
}

enum NivelDificuldade {
  FACIL
  MEDIO
  DIFICIL

  @@map("nivel_dificuldade")
}

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  nome         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(255)
  senha        String        @db.VarChar(255)
  tipo         TipoUsuario   @default(ALUNO)
  status       StatusUsuario @default(PENDENTE)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  // A senha vale por 90 dias a partir desta data.
  senhaAtualizadaEm DateTime @default(now()) @map("senha_atualizada_em") @db.Timestamptz(3)

  perfil           Perfil?
  codigosValidacao CodigoValidacao[]

  arquivos Arquivo[]

  cursosResponsavel Curso[] @relation("CursoResponsavel")
  cursosAutorizados Curso[] @relation("CursoAutorizado")

  sessoesResponsavel Sessao[]
  modulosResponsavel Modulo[]
  aulasResponsavel   Aula[]

  testesResponsavel       Teste[]
  questoesResponsavel     Questao[]
  alternativasResponsavel Alternativa[]

  inscricoes Inscricao[]

  progressosAula ProgressoAula[]
  tentativas     TentativaTeste[]
  movimentacoes  MovimentacaoRecompensa[]
  inventario     InventarioItem[]
  ativacoes      AtivacaoItem[]
  flashcards     Flashcard[]

  @@map("usuario")
}

model Perfil {
  idUsuario         String     @id @map("id_usuario") @db.Uuid
  tipoPerfil        TipoPerfil @default(PRIVADO) @map("tipo_perfil")
  planoContaId      String?    @map("plano_conta") @db.Uuid
  xp                Int        @default(0)
  moedas            Int        @default(0)
  nivel             Int        @default(0)
  cor               String     @default("") @db.VarChar(30)
  decoracaoId       String?    @map("decoracao") @db.Uuid
  urlFotoPerfil     String     @default("") @map("url_foto_perfil") @db.Text
  urlFotoBackground String     @default("") @map("url_foto_background") @db.Text

  // Sequência de dias seguidos com atividade de estudo.
  sequenciaDias     Int       @default(0) @map("sequencia_dias")
  ultimaAtividadeEm DateTime? @map("ultima_atividade_em") @db.Timestamptz(3)

  usuario    Usuario     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  planoConta PlanoConta? @relation(fields: [planoContaId], references: [id], onDelete: SetNull)

  @@map("perfil")
}

model CodigoValidacao {
  id          String                @id @default(uuid()) @db.Uuid
  idUsuario   String                @map("id_usuario") @db.Uuid
  codigo      String                @db.VarChar(64)
  dataCriacao DateTime              @default(now()) @map("data_criacao") @db.Timestamptz(3)
  expiraEm    DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '10 minutes')")) @map("expira_em") @db.Timestamptz(3)
  status      StatusCodigoValidacao @default(ATIVO)
  finalidade  FinalidadeCodigo      @default(VALIDACAO_CONTA)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario, status])
  @@index([expiraEm, status])
  @@map("codigo_validacao")
}

model Arquivo {
  id String @id @default(uuid()) @db.Uuid

  idOrigem String @map("id_origem") @db.Uuid

  tipo       TipoArquivo
  finalidade FinalidadeArquivo

  nomeOriginal String @map("nome_original") @db.VarChar(255)

  chaveObjeto String @unique @map("chave_objeto") @db.VarChar(512)

  bucket String @db.VarChar(255)

  contentType String @map("content_type") @db.VarChar(150)

  tamanhoBytes BigInt @map("tamanho_bytes")

  etag String? @db.VarChar(255)

  status StatusArquivo @default(PENDENTE)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idOrigem], references: [id], onDelete: Restrict)

  aula      Aula?  @relation("ArquivoAula")
  cursoCapa Curso? @relation("ArquivoCapaCurso")

  @@index([idOrigem])
  @@index([finalidade])
  @@index([tipo])
  @@index([status])
  @@map("arquivo")
}

model Curso {
  id        String         @id @default(uuid()) @db.Uuid
  nome      String         @db.VarChar(150)
  categoria CategoriaCurso
  status    StatusCurso    @default(INATIVO)
  vagas     Int?
  preco     Decimal?       @db.Decimal(10, 2)
  descricao String?        @db.Text
  cor       String?        @db.VarChar(30)

  // Capa do curso: arquivo enviado ou ícone selecionado
  idCapa    String? @unique @map("id_capa") @db.Uuid
  iconeCapa String? @map("icone_capa") @db.VarChar(30)

  // Responsáveis
  idResponsavel      String  @map("id_responsavel") @db.Uuid
  idAdminAutorizador String? @map("id_admin_autorizador") @db.Uuid

  // Datas
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  autorizadoEm DateTime? @map("autorizado_em") @db.Timestamptz(3)

  // Relacionamentos
  arquivoCapa      Arquivo? @relation("ArquivoCapaCurso", fields: [idCapa], references: [id], onDelete: SetNull)
  responsavel      Usuario  @relation("CursoResponsavel", fields: [idResponsavel], references: [id], onDelete: Restrict)
  adminAutorizador Usuario? @relation("CursoAutorizado", fields: [idAdminAutorizador], references: [id], onDelete: SetNull)

  sessoes    Sessao[]
  inscricoes Inscricao[]

  @@index([nome])
  @@index([categoria])
  @@index([status])
  @@index([idResponsavel])
  @@map("curso")
}

model Sessao {
  id String @id @default(uuid()) @db.Uuid

  idCurso String @map("id_curso") @db.Uuid

  titulo    String  @db.VarChar(150)
  subtitulo String? @db.VarChar(200)
  descricao String? @db.Text

  idResponsavel String @map("id_responsavel") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  curso       Curso   @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  modulos Modulo[]

  @@index([idCurso])
  @@index([idResponsavel])
  @@map("sessao")
}

model Modulo {
  id String @id @default(uuid()) @db.Uuid

  idSessao String @map("id_sessao") @db.Uuid

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text

  // Lição do módulo: concede XP quando todo o conteúdo é concluído.
  licaoTitulo String? @map("licao_titulo") @db.VarChar(150)
  xp          Int     @default(0)

  idResponsavel String @map("id_responsavel") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  sessao      Sessao  @relation(fields: [idSessao], references: [id], onDelete: Cascade)
  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  aulas  Aula[]
  testes Teste[]

  @@index([idSessao])
  @@index([idResponsavel])
  @@map("modulo")
}

model Aula {
  id String @id @default(uuid()) @db.Uuid

  idModulo String @map("id_modulo") @db.Uuid

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text

  idArquivo String? @unique @map("id_arquivo") @db.Uuid

  tipo TipoMaterial

  quantidadePaginas Int? @map("quantidade_paginas")
  duracaoMinutos    Int? @map("duracao_minutos")

  idResponsavel String @map("id_responsavel") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  modulo      Modulo   @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  arquivo     Arquivo? @relation("ArquivoAula", fields: [idArquivo], references: [id], onDelete: SetNull)
  responsavel Usuario  @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  progressos ProgressoAula[]

  @@index([idModulo])
  @@index([idResponsavel])
  @@map("aula")
}

model Teste {
  id String @id @default(uuid()) @db.Uuid

  idModulo String? @map("id_modulo") @db.Uuid

  idResponsavel String @map("id_responsavel") @db.Uuid

  tipo TipoTeste
  tema String?   @db.VarChar(150)

  tempoMinutos Int @default(5) @map("tempo_minutos")

  quantidadeQuestoes Int @default(0) @map("quantidade_questoes")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  modulo      Modulo? @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  questoes   TesteQuestao[]
  tentativas TentativaTeste[]

  @@index([idModulo])
  @@index([idResponsavel])
  @@index([tipo])
  @@map("teste")
}

model Questao {
  id                   String  @id @default(uuid()) @db.Uuid
  idResponsavel        String  @map("id_responsavel") @db.Uuid
  idAlternativaCorreta String? @map("id_alternativa_correta") @db.Uuid

  titulo      String?          @db.VarChar(150)
  enunciado   String           @db.Text
  dificuldade NivelDificuldade @default(MEDIO)

  // Classificação usada nos filtros e na geração de simulados.
  materia CategoriaCurso?
  tema    String?         @db.VarChar(150)

  // Comentário exibido no gabarito.
  explicacao String? @db.Text

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  alternativaCorreta Alternativa? @relation("AlternativaCorreta", fields: [idAlternativaCorreta], references: [id], onDelete: SetNull)

  alternativas Alternativa[]  @relation("AlternativasQuestao")
  testes       TesteQuestao[]
  respostas    RespostaTentativa[]

  @@index([idResponsavel])
  @@index([idAlternativaCorreta])
  @@index([dificuldade])
  @@index([materia])
  @@map("questao")
}

model Alternativa {
  id            String @id @default(uuid()) @db.Uuid
  idQuestao     String @map("id_questao") @db.Uuid
  idResponsavel String @map("id_responsavel") @db.Uuid

  texto String @db.Text
  ordem Int    @default(0)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  questao Questao @relation("AlternativasQuestao", fields: [idQuestao], references: [id], onDelete: Cascade)

  questoesCorretas Questao[] @relation("AlternativaCorreta")
  respostas        RespostaTentativa[]

  responsavel Usuario @relation(fields: [idResponsavel], references: [id], onDelete: Restrict)

  @@index([idQuestao])
  @@index([idResponsavel])
  @@map("alternativa")
}

model TesteQuestao {
  id String @id @default(uuid()) @db.Uuid

  idTeste   String @map("id_teste") @db.Uuid
  idQuestao String @map("id_questao") @db.Uuid

  ordem Int @default(0)

  teste   Teste   @relation(fields: [idTeste], references: [id], onDelete: Cascade)
  questao Questao @relation(fields: [idQuestao], references: [id], onDelete: Cascade)

  @@unique([idTeste, idQuestao])
  @@index([idQuestao])
  @@map("teste_questao")
}

model Inscricao {
  id String @id @default(uuid()) @db.Uuid

  idUsuario String @map("id_usuario") @db.Uuid
  idCurso   String @map("id_curso") @db.Uuid

  turma TurmaInscricao @default(EAD)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  curso   Curso   @relation(fields: [idCurso], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idCurso])
  @@index([idCurso])
  @@map("inscricao")
}

enum TurmaInscricao {
  MANHA
  TARDE
  NOITE
  EAD

  @@map("turma_inscricao")
}

// ---------------------------------------------------------------------------
// Planos de conta
// ---------------------------------------------------------------------------

model PlanoConta {
  id                  String   @id @default(uuid()) @db.Uuid
  nome                String   @unique @db.VarChar(40)
  precoCentavos       Int      @default(0) @map("preco_centavos")
  cor                 String   @default("") @db.VarChar(30)
  icone               String   @default("") @db.VarChar(40)
  destaque            String?  @db.VarChar(40)
  beneficios          String[]
  indisponiveis       String[]
  limiteSimuladosMes  Int?     @map("limite_simulados_mes")
  ordem               Int      @default(0)

  perfis Perfil[]

  @@map("plano_conta")
}

// ---------------------------------------------------------------------------
// Progresso e tentativas
// ---------------------------------------------------------------------------

model ProgressoAula {
  idUsuario   String   @map("id_usuario") @db.Uuid
  idAula      String   @map("id_aula") @db.Uuid
  concluidoEm DateTime @default(now()) @map("concluido_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  aula    Aula    @relation(fields: [idAula], references: [id], onDelete: Cascade)

  @@id([idUsuario, idAula])
  @@map("progresso_aula")
}

enum StatusTentativa {
  EM_ANDAMENTO
  FINALIZADA

  @@map("status_tentativa")
}

// Uma realização de simulado ou atividade por um usuário.
model TentativaTeste {
  id           String           @id @default(uuid()) @db.Uuid
  idTeste      String           @map("id_teste") @db.Uuid
  idUsuario    String           @map("id_usuario") @db.Uuid
  status       StatusTentativa  @default(EM_ANDAMENTO)
  materias     CategoriaCurso[]
  dificuldade  NivelDificuldade?
  tempoMinutos Int              @map("tempo_minutos")
  iniciadoEm   DateTime         @default(now()) @map("iniciado_em") @db.Timestamptz(3)
  finalizadoEm DateTime?        @map("finalizado_em") @db.Timestamptz(3)
  total        Int
  acertos      Int?
  nota         Int?
  xpGanho      Int              @default(0) @map("xp_ganho")
  moedasGanhas Int              @default(0) @map("moedas_ganhas")

  teste     Teste               @relation(fields: [idTeste], references: [id], onDelete: Cascade)
  usuario   Usuario             @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  respostas RespostaTentativa[]

  @@index([idUsuario, iniciadoEm])
  @@index([idTeste])
  @@map("tentativa_teste")
}

model RespostaTentativa {
  idTentativa   String    @map("id_tentativa") @db.Uuid
  idQuestao     String    @map("id_questao") @db.Uuid
  ordem         Int
  idAlternativa String?   @map("id_alternativa") @db.Uuid
  respondidaEm  DateTime? @map("respondida_em") @db.Timestamptz(3)
  correta       Boolean?
  dicaUsada     Boolean   @default(false) @map("dica_usada")

  tentativa   TentativaTeste @relation(fields: [idTentativa], references: [id], onDelete: Cascade)
  questao     Questao        @relation(fields: [idQuestao], references: [id], onDelete: Cascade)
  alternativa Alternativa?   @relation(fields: [idAlternativa], references: [id], onDelete: SetNull)

  @@id([idTentativa, idQuestao])
  @@map("resposta_tentativa")
}

// ---------------------------------------------------------------------------
// Recompensas (XP e moedas)
// ---------------------------------------------------------------------------

enum OrigemRecompensa {
  AULA
  MODULO
  ATIVIDADE
  SIMULADO
  COMPRA
  AJUSTE

  @@map("origem_recompensa")
}

model MovimentacaoRecompensa {
  id         String           @id @default(uuid()) @db.Uuid
  idUsuario  String           @map("id_usuario") @db.Uuid
  origem     OrigemRecompensa
  referencia String?          @db.VarChar(64)
  xp         Int              @default(0)
  moedas     Int              @default(0)
  criadoEm   DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario, criadoEm])
  @@map("movimentacao_recompensa")
}

// ---------------------------------------------------------------------------
// Loja e inventário
// ---------------------------------------------------------------------------

enum EfeitoItem {
  BOOST_XP
  ESCUDO_SEQUENCIA
  DICA_EXTRA
  TEMPO_EXTRA
  REVIVER_TENTATIVA
  COSMETICO

  @@map("efeito_item")
}

enum StatusAtivacao {
  ATIVO
  EXPIRADO
  CONSUMIDO

  @@map("status_ativacao")
}

model Item {
  id             String     @id @default(uuid()) @db.Uuid
  nome           String     @unique @db.VarChar(80)
  descricao      String     @default("") @db.Text
  preco          Int
  icone          String     @default("star") @db.VarChar(40)
  cor            String     @default("#425BC2") @db.VarChar(30)
  categoria      String     @db.VarChar(40)
  efeito         EfeitoItem
  valorEfeito    Int        @default(0) @map("valor_efeito")
  duracaoMinutos Int?       @map("duracao_minutos")
  ativo          Boolean    @default(true)
  criadoEm       DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)

  inventario InventarioItem[]
  ativacoes  AtivacaoItem[]

  @@map("item")
}

model InventarioItem {
  idUsuario  String @map("id_usuario") @db.Uuid
  idItem     String @map("id_item") @db.Uuid
  quantidade Int    @default(0)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [idItem], references: [id], onDelete: Cascade)

  @@id([idUsuario, idItem])
  @@map("inventario_item")
}

model AtivacaoItem {
  id        String         @id @default(uuid()) @db.Uuid
  idUsuario String         @map("id_usuario") @db.Uuid
  idItem    String         @map("id_item") @db.Uuid
  status    StatusAtivacao @default(ATIVO)
  ativadoEm DateTime       @default(now()) @map("ativado_em") @db.Timestamptz(3)
  expiraEm  DateTime?      @map("expira_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [idItem], references: [id], onDelete: Cascade)

  @@index([idUsuario, status])
  @@index([status, expiraEm])
  @@map("ativacao_item")
}

// ---------------------------------------------------------------------------
// Flashcards
// ---------------------------------------------------------------------------

model Flashcard {
  id                String    @id @default(uuid()) @db.Uuid
  idUsuario         String    @map("id_usuario") @db.Uuid
  titulo            String    @db.VarChar(120)
  pergunta          String    @db.Text
  resposta          String    @db.Text
  repeticoesMensais Int       @default(4) @map("repeticoes_mensais")
  ultimaRevisaoEm   DateTime? @map("ultima_revisao_em") @db.Timestamptz(3)
  proximaRevisaoEm  DateTime? @map("proxima_revisao_em") @db.Timestamptz(3)
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@map("flashcard")
}
